@page "/login"
@page "/signup"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>@(IsSignUpMode ? "Sign Up" : "Sign In") - Journal App</PageTitle>

<div class="auth-card">
    <h3 class="auth-title">
        @(IsSignUpMode ? "Create Account" : "Welcome Back")
    </h3>
    <p class="auth-subtitle">
        @(IsSignUpMode ? "Sign up to start your journal" : "Sign in to continue")
    </p>

    <EditForm Model="@Model" OnValidSubmit="@HandleSubmit">
        <DataAnnotationsValidator />

        <div class="auth-field">
            <label class="auth-label">Username</label>
            <InputText class="auth-input" @bind-Value="@Model.Username" placeholder="Enter username" />
            <ValidationMessage For="@(() => Model.Username)" />
        </div>

        <div class="auth-field">
            <label class="auth-label">Password</label>
            <InputText type="password" class="auth-input" @bind-Value="@Model.Password" placeholder="Enter password" />
            <ValidationMessage For="@(() => Model.Password)" />
        </div>

        @if (IsSignUpMode)
        {
            <div class="auth-field">
                <label class="auth-label">Confirm Password</label>
                <InputText type="password" class="auth-input" @bind-Value="@Model.ConfirmPassword" placeholder="Confirm password" />
                <ValidationMessage For="@(() => Model.ConfirmPassword)" />
            </div>
        }

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="auth-error">@ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(SuccessMessage))
        {
            <div class="auth-success">@SuccessMessage</div>
        }

        <button type="submit" class="auth-submit-btn" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner"></span>
            }
            @(IsSignUpMode ? "Sign Up" : "Sign In")
        </button>
    </EditForm>

    <div class="auth-switch">
        @if (IsSignUpMode)
        {
            <span>Already have an account? </span>
            <a href="javascript:void(0)" @onclick="SwitchToSignIn">Sign In</a>
        }
        else
        {
            <span>Don't have an account? </span>
            <a href="javascript:void(0)" @onclick="SwitchToSignUp">Sign Up</a>
        }
    </div>
</div>

@code {
    private bool IsSignUpMode { get; set; }
    private bool IsLoading { get; set; }
    private AuthModel Model { get; set; } = new();
    private string ErrorMessage { get; set; } = string.Empty;
    private string SuccessMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Check if already authenticated
        if (AuthService.IsAuthenticated)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Determine mode based on URL
        var uri = new Uri(Navigation.Uri);
        IsSignUpMode = uri.AbsolutePath.Contains("signup", StringComparison.OrdinalIgnoreCase);

        // If no users exist, default to signup mode
        var hasUsers = await AuthService.HasAnyUsersAsync();
        if (!hasUsers)
        {
            IsSignUpMode = true;
        }
    }

    private void SwitchToSignUp()
    {
        IsSignUpMode = true;
        ClearMessages();
        Model = new AuthModel();
    }

    private void SwitchToSignIn()
    {
        IsSignUpMode = false;
        ClearMessages();
        Model = new AuthModel();
    }

    private void ClearMessages()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;
    }

    private async Task HandleSubmit()
    {
        try
        {
            ClearMessages();
            IsLoading = true;

            if (IsSignUpMode)
            {
                // Validate confirm password
                if (Model.Password != Model.ConfirmPassword)
                {
                    ErrorMessage = "Passwords do not match.";
                    return;
                }

                var (success, error) = await AuthService.RegisterAsync(Model.Username, Model.Password);

                if (success)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    ErrorMessage = error;
                }
            }
            else
            {
                var (success, error) = await AuthService.LoginAsync(Model.Username, Model.Password);

                if (success)
                {
                    Navigation.NavigateTo("/");
                }
                else
                {
                    ErrorMessage = error;
                }
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An unexpected error occurred. Please try again.";
            Console.WriteLine($"Auth error: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
        }
    }

    public class AuthModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
