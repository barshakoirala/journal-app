@page "/login"
@page "/setup-password"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Security - Journal App</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    @if (IsSetupMode)
                    {
                        <h3 class="card-title text-center mb-4">Set Up Password Protection</h3>
                        <p class="text-muted text-center">Create a password to protect your journal entries.</p>
                    }
                    else
                    {
                        <h3 class="card-title text-center mb-4">Enter Password</h3>
                        <p class="text-muted text-center">Please enter your password to access your journal.</p>
                    }

                    <EditForm Model="@Model" OnValidSubmit="@HandleSubmit">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <InputText type="password" class="form-control" @bind-Value="@Model.Password" />
                            <ValidationMessage For="@(() => Model.Password)" />
                        </div>

                        @if (IsSetupMode)
                        {
                            <div class="mb-3">
                                <label class="form-label">Confirm Password</label>
                                <InputText type="password" class="form-control" @bind-Value="@Model.ConfirmPassword" />
                                <ValidationMessage For="@(() => Model.ConfirmPassword)" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger">@ErrorMessage</div>
                        }

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">
                                @(IsSetupMode ? "Set Password" : "Login")
                            </button>
                        </div>
                    </EditForm>

                    @if (!IsSetupMode)
                    {
                        <div class="mt-3 text-center">
                            <small class="text-muted">Forgot your password? You'll need to reset the app data.</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Mode { get; set; }
    
    private bool IsSetupMode { get; set; }
    private LoginModel Model { get; set; } = new();
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var isPasswordSet = await AuthService.IsPasswordSetAsync();
        IsSetupMode = !isPasswordSet || Mode == "setup";
        
        // If authenticated, redirect to home
        if (AuthService.IsAuthenticated && !IsSetupMode)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            ErrorMessage = string.Empty;

            if (IsSetupMode)
            {
                if (Model.Password != Model.ConfirmPassword)
                {
                    ErrorMessage = "Passwords do not match.";
                    return;
                }

                if (string.IsNullOrWhiteSpace(Model.Password) || Model.Password.Length < 4)
                {
                    ErrorMessage = "Password must be at least 4 characters long.";
                    return;
                }

                await AuthService.SetPasswordAsync(Model.Password);
                Navigation.NavigateTo("/");
            }
            else
            {
                await AuthService.LoginAsync(Model.Password);
                Navigation.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    public class LoginModel
    {
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
