<div class="sidebar-container">
    <!-- Animated Background -->
    <div class="sidebar-bg">
        <div class="gradient-orb orb-1"></div>
        <div class="gradient-orb orb-2"></div>
        <div class="gradient-orb orb-3"></div>
    </div>

    <!-- Header -->
    <div class="sidebar-header">
        <div class="logo-wrapper">
            <div class="logo-glow"></div>
            <div class="logo-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                    <path d="M8 7h6"/>
                    <path d="M8 11h8"/>
                </svg>
            </div>
            <div class="logo-text">
                <span class="app-name">Journal</span>
                <span class="app-version">v1.0</span>
            </div>
        </div>
        <button title="Toggle menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
    </div>

    <!-- Navigation -->
    <div class="@NavMenuCssClass nav-scrollable">
        <nav class="nav-menu">
            <!-- Quick Actions -->
            <div class="quick-action">
                <a class="create-btn" href="journal/create">
                    <span class="create-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </span>
                    <span class="create-text">New Entry</span>
                    <span class="shortcut">⌘N</span>
                </a>
            </div>

            <!-- Main Navigation -->
            <div class="nav-section">
                <div class="nav-section-title">
                    <span class="section-line"></span>
                    <span>Navigation</span>
                    <span class="section-line"></span>
                </div>
                
                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="nav-icon-wrapper home">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                        </span>
                        <span class="nav-text">Home</span>
                    </NavLink>
                </div>

                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="journal/list">
                        <span class="nav-icon-wrapper journal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                            </svg>
                        </span>
                        <span class="nav-text">My Journal</span>
                    </NavLink>
                </div>

                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="calendar">
                        <span class="nav-icon-wrapper calendar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="18" height="18" x="3" y="4" rx="2" ry="2"/>
                                <line x1="16" x2="16" y1="2" y2="6"/>
                                <line x1="8" x2="8" y1="2" y2="6"/>
                                <line x1="3" x2="21" y1="10" y2="10"/>
                            </svg>
                        </span>
                        <span class="nav-text">Calendar</span>
                    </NavLink>
                </div>
            </div>

            <!-- Analytics Section -->
            <div class="nav-section">
                <div class="nav-section-title">
                    <span class="section-line"></span>
                    <span>Analytics</span>
                    <span class="section-line"></span>
                </div>

                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="nav-icon-wrapper stats">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 3v18h18"/>
                                <path d="m19 9-5 5-4-4-3 3"/>
                            </svg>
                        </span>
                        <span class="nav-text">Dashboard</span>
                        <span class="nav-badge">New</span>
                    </NavLink>
                </div>

                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="export">
                        <span class="nav-icon-wrapper export">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" x2="12" y1="15" y2="3"/>
                            </svg>
                        </span>
                        <span class="nav-text">Export</span>
                    </NavLink>
                </div>
            </div>

            <!-- Settings Section -->
            <div class="nav-section">
                <div class="nav-section-title">
                    <span class="section-line"></span>
                    <span>Account</span>
                    <span class="section-line"></span>
                </div>

                <div class="nav-item-wrapper">
                    <NavLink class="nav-link" href="settings">
                        <span class="nav-icon-wrapper settings">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                            </svg>
                        </span>
                        <span class="nav-text">Settings</span>
                    </NavLink>
                </div>
            </div>
        </nav>

        <!-- Bottom Card -->
        <div class="sidebar-footer">
            <div class="promo-card">
                <div class="promo-glow"></div>
                <div class="promo-content">
                    <div class="promo-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
                        </svg>
                    </div>
                    <div class="promo-text-wrap">
                        <span class="promo-title">Keep the streak!</span>
                        <span class="promo-text">Write daily to build your habit</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
